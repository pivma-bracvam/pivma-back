# Configurações do Banco de Dados PostgreSQL (psycopg3 async)
DATABASE_URL="postgresql+psycopg://db_user:db_password@localhost:5432/db"

# Autenticação: use uma chave aleatória com pelo menos 32 bytes.
JWT_SECRET_KEY="replace-with-at-least-32-random-bytes"

# Lista JSON de origens autorizadas a enviar cookies de autenticação.
AUTH_ALLOWED_ORIGINS='["http://localhost:3000", "http://localhost:8000"]'


# --- Avaliação por IA (Spec 013) ---
# Provedor: "openai" (produção) ou "fake" (determinístico, sem rede).
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-..."
# Modelos por camada (ajuste fino é opcional).
AI_MODEL_EXTRACTION="gpt-5.4-nano"
AI_MODEL_FAST="gpt-5.4-nano"
AI_MODEL_REASONING="gpt-5.4-mini"


# --- Notificações (Spec 036) ---
# Canal de e-mail: "smtp", "fake" (só testes) ou vazio (convite por e-mail
# desativado). Com o compose, o Mailpit recebe tudo em http://localhost:8025.
# NOTIFICATION_EMAIL_BACKEND="smtp"
# SMTP_HOST="mailpit"
# SMTP_PORT=1025
# SMTP_SECURITY="none"            # "starttls" (587), "ssl" (465) ou "none"
# SMTP_USERNAME=""
# SMTP_PASSWORD=""
# NOTIFICATION_FROM_ADDRESS="nao-responda@pivma.local"
# NOTIFICATION_FROM_NAME="pi*VMA"
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NOTIFICATION_ENCRYPTION_KEY=""
# Endereço da página de aceite do convite no frontend, com {token}.
# INVITE_URL_TEMPLATE="http://localhost:3000/convites/{token}"
# Endereço da página de redefinição de senha no frontend, com {token}.
# PASSWORD_RESET_URL_TEMPLATE="http://localhost:3000/redefinir-senha/{token}"
