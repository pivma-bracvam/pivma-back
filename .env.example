# Configurações do Banco de Dados PostgreSQL (psycopg3 async)
DATABASE_URL="postgresql+psycopg://db_user:db_password@localhost:5432/db"

# Autenticação: use uma chave aleatória com pelo menos 32 bytes.
JWT_SECRET_KEY="replace-with-at-least-32-random-bytes"

# Lista JSON de origens autorizadas a enviar cookies de autenticação.
AUTH_ALLOWED_ORIGINS='["http://localhost:3000", "http://localhost:8000"]'


# --- Avaliação por IA (Spec 013) ---
# Provedor: "openai" (produção) ou "fake" (determinístico, sem rede).
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-..."
# Modelos por camada (ajuste fino é opcional).
AI_MODEL_EXTRACTION="gpt-5.4-nano"
AI_MODEL_FAST="gpt-5.4-nano"
AI_MODEL_REASONING="gpt-5.4-mini"
